{{ printf "<?xml version=\"1.0\" encoding=\"UTF-8\"?>" | safeHTML }}
{{ printf "<rss version=\"2.0\" xmlns:atom=\"http://www.w3.org/2005/Atom\" xmlns:itunes=\"http://www.itunes.com/dtds/podcast-1.0.dtd\">" | safeHTML }}
<channel>
  <title>{{ .Site.Title }}</title>
  <link>{{ .Permalink }}</link>
  <description>{{ with .Site.Params.description }}{{ . }}{{ else }}{{ .Site.Title }}{{ end }}</description>
  <language>{{ .Site.LanguageCode }}</language>
  <managingEditor>{{ .Site.Params.itunes_author }}</managingEditor>
  <webMaster>{{ .Site.Params.itunes_owner_email }}</webMaster>
  <copyright>{{ now.Year }} {{ .Site.Params.itunes_author }}</copyright>
  <lastBuildDate>{{ now.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
  <atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml"/>
  {{ with .Site.Params.itunes_image }}
  <itunes:image href="{{ . | absURL }}"/>
  {{ end }}
  {{ with .Site.Params.itunes_category }}
  <itunes:category text="{{ . }}"/>
  {{ end }}
  <itunes:explicit>{{ .Site.Params.itunes_explicit | default "no" }}</itunes:explicit>
  
  {{ range first 50 (where .Data.Pages "Type" "in" .Site.Params.mainSections) }}
  <item>
    <title>{{ .Title }}</title>
    <link>{{ .Permalink }}</link>
    <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
    <guid isPermaLink="false">{{ .File.Path }}</guid>
    <description>{{ .Description | htmlEscape }}</description>
    {{ with .Params.podcast_file }}
    <enclosure url="{{ $.Site.Params.media_prefix }}{{ . }}" length="0" type="audio/mpeg"/>
    {{ end }}
    {{ with .Params.itunes_duration }}
    <itunes:duration>{{ . }}</itunes:duration>
    {{ end }}
  </item>
  {{ end }}
</channel>
</rss>
