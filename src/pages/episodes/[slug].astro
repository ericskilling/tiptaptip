---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AudioPlayer from '../../components/AudioPlayer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const episodes = await getCollection('episodes');
  return episodes.map((episode) => ({
    params: { slug: episode.id.replace(/\.(md|mdx)$/, '') },
    props: { episode },
  }));
}

const { episode } = Astro.props;
const { Content } = await render(episode);
const { title, date, author, tags, episode_image, podcast_file, images } = episode.data;
const description = (episode.data as { description?: string }).description;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const episodeNumber = episode.id.match(/(\d+)/)?.[1] || '';
---

<BaseLayout title={title}>
  <article class="episode-page">
    <section class="section-card episode-hero">
      <span class="episode-pill">Episode {episodeNumber}</span>
      <h1>{title}</h1>
      {description && <p class="episode-description">{description}</p>}

      <div class="episode-meta">
        <time datetime={date.toISOString()}>{formattedDate}</time>
        {author.length > 0 && (
          <span class="episode-meta-separator">•</span>
        )}
        {author.length > 0 && <span>with {author.join(' & ')}</span>}
      </div>

      {tags.length > 0 && (
        <div class="tags">
          {tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )}
    </section>

    {podcast_file && (
      <section class="section-card episode-player">
        <AudioPlayer src={podcast_file} title={title} />
      </section>
    )}

    <section class="section-card episode-content">
      <Content />
    </section>

    {images && images.length > 0 && (
      <section class="section-card episode-images">
        {images.slice(1).map((img) => (
          <img src={img} alt="" />
        ))}
      </section>
    )}

    <nav class="episode-nav">
      <a href="/episodes">&larr; Back to Episodes</a>
    </nav>
  </article>
</BaseLayout>
