---
interface Props {
  src: string;
  title: string;
}

const { src, title } = Astro.props;
---

<div class="audio-player">
  <audio controls preload="none">
    <source src={src} type="audio/mpeg" />
    Your browser does not support the audio element.
  </audio>
  <p class="now-playing">Now Playing: {title}</p>
</div>

<style>
  .audio-player {
    background: var(--panel);
    padding: 1rem;
    border-radius: 1rem;
    margin: 1rem 0;
    border: 1px solid var(--border);
  }

  audio {
    width: 100%;
  }

  .now-playing {
    font-size: 0.875rem;
    color: var(--muted);
    margin-top: 0.5rem;
  }

  @media (max-width: 639px) {
    .audio-player {
      padding: 0.875rem;
    }
    
    .now-playing {
      font-size: 0.8rem;
    }
  }
</style>